# Server
PORT=3000
NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=proof_of_crash
DB_USER=poc_user
DB_PASSWORD=poc_password

# Authentication
JWT_SECRET=195c3ee6aa4ae11065570c8bb48d508d5cb010fe6fcd5a1d90e8ab31d3e6c73173a0593c132e9cf19d95ed5b88892fea
# Access-token lifetime (seconds). Short-lived by design; clients use the
# refresh token for longevity. Default 900 (15 minutes).
JWT_TTL_SECONDS=900
# Refresh-token lifetime (seconds). Default 2592000 (30 days).
REFRESH_TOKEN_TTL_SECONDS=2592000
# Comma-separated list of 64-hex-char addresses allowed to call admin endpoints
# (e.g. POST /api/ledger/finalize). Empty = endpoint is unreachable.
# Leaving this empty until now.
ADMIN_ADDRESSES=

# Rate limiting (per IP). Challenge endpoint is throttled hardest because it
# writes to auth_challenges on every call.
AUTH_CHALLENGE_RATE_WINDOW_MS=60000
AUTH_CHALLENGE_RATE_MAX=10
AUTH_RATE_WINDOW_MS=60000
AUTH_RATE_MAX=20

# CORS. Comma-separated allowlist of frontend origins. Must NOT be "*" in
# production. Empty in production = deny all cross-origin; empty in dev =
# reflect any origin.
CORS_ALLOWED_ORIGINS=
CORS_ALLOW_CREDENTIALS=true

# Cookie auth (optional HttpOnly mode, complementary to Bearer tokens).
AUTH_COOKIE_ENABLED=true
# Secure flag: defaults to true when NODE_ENV=production, false otherwise.
# Override explicitly if needed (e.g. behind TLS-terminating proxy in staging).
AUTH_COOKIE_SECURE=
# Optional cookie domain (e.g. .example.com). Leave empty for host-only cookies.
AUTH_COOKIE_DOMAIN=

# Reverse-proxy trust for correct client IPs (used by rate limiting + audit).
# 'loopback' (default), 'true', a hop count, or a CIDR/IP list.
TRUST_PROXY=loopback

